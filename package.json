{
  "name": "rollcage",
  "version": "0.0.0",
  "private": true,
  "description": "Rollcage: making AI-accelerated delivery safe to ship",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm -r --if-present coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage",
    "demo:01": "pnpm --filter @adl/pr-risk-gate demo",
    "demo:01:reset": "pnpm --filter @adl/pr-risk-gate demo:reset",
    "policy:check": "pnpm --filter @adl/agent-policy exec tsx src/bin.ts check --root ../..",
    "demo:02": "pnpm --filter @adl/agent-policy demo",
    "demo:02:reset": "pnpm --filter @adl/agent-policy demo:reset",
    "demo:03": "pnpm --filter @adl/dora-metrics demo",
    "demo:03:reset": "pnpm --filter @adl/dora-metrics demo:reset",
    "demo:04": "pnpm --filter @adl/secrets-guard demo",
    "demo:04:reset": "pnpm --filter @adl/secrets-guard demo:reset",
    "policy:selftest": "pnpm --filter @adl/agent-policy exec tsx src/bin.ts selftest --root ../..",
    "demo:05": "pnpm --filter @adl/sbom-vuln-triage demo",
    "demo:05:reset": "pnpm --filter @adl/sbom-vuln-triage demo:reset",
    "demo:06": "pnpm --filter @adl/policy-gates demo",
    "demo:06:reset": "pnpm --filter @adl/policy-gates demo:reset",
    "demo:07": "pnpm --filter @adl/ci-failure-triage demo",
    "demo:07:reset": "pnpm --filter @adl/ci-failure-triage demo:reset",
    "demo:08": "pnpm --filter @adl/aws-cost-explainer demo",
    "demo:08:reset": "pnpm --filter @adl/aws-cost-explainer demo:reset",
    "demo:09": "pnpm --filter @adl/postmortem-drafter demo",
    "demo:09:reset": "pnpm --filter @adl/postmortem-drafter demo:reset",
    "demo:10": "pnpm --filter @adl/provenance-signing demo",
    "demo:10:reset": "pnpm --filter @adl/provenance-signing demo:reset",
    "demo:11": "pnpm --filter @adl/rag-onboarding demo",
    "demo:11:reset": "pnpm --filter @adl/rag-onboarding demo:reset",
    "demo:12": "pnpm --filter @adl/golden-path-template demo",
    "demo:12:reset": "pnpm --filter @adl/golden-path-template demo:reset",
    "demo:13": "pnpm --filter @adl/multi-agent-workflow demo",
    "demo:13:reset": "pnpm --filter @adl/multi-agent-workflow demo:reset",
    "demo:14": "pnpm --filter @adl/ai-dev-tool-eval demo",
    "demo:14:reset": "pnpm --filter @adl/ai-dev-tool-eval demo:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Barret Nobel (https://github.com/frankTurtle)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankTurtle/rollcage.git"
  },
  "homepage": "https://github.com/frankTurtle/rollcage#readme"
}
